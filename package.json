{
  "name": "deepseek-harness-peak-reminder",
  "version": "1.7.1",
  "type": "module",
  "description": "DeepSeek Harness plugin: live DeepSeek API peak-hours clock, desktop notifications, token usage and cost, account balance, and RTL text.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek-api",
    "peak-hours",
    "off-peak",
    "pricing",
    "token-usage",
    "cost-estimator",
    "notifications",
    "rtl",
    "persian",
    "farsi",
    "electron"
  ],
  "author": "Amir Keshtkar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Keshtkar/deepseek-harness-peak-reminder.git"
  },
  "homepage": "https://github.com/Amir-Keshtkar/deepseek-harness-peak-reminder#readme",
  "bugs": {
    "url": "https://github.com/Amir-Keshtkar/deepseek-harness-peak-reminder/issues"
  },
  "scripts": {
    "sync": "node scripts/sync-schedule.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "schedule.json",
    "locale/*.json",
    "docs",
    "scripts",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
